#!/bin/bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APK_DIR="$ROOT_DIR/apk"

if [[ $# -lt 1 ]]; then
  echo "Usage: $(basename "$0") <source-apk> [label]" >&2
  exit 1
fi

SRC="$1"
LABEL="${2:-SumoApp}"

if [[ ! -f "$SRC" ]]; then
  echo "Source APK not found: $SRC" >&2
  exit 1
fi

mkdir -p "$APK_DIR"

shopt -s nullglob
existing=("$APK_DIR/${LABEL}-v"*.apk)
next_version=1

if [[ ${#existing[@]} -gt 0 ]]; then
  max_version=0
  for file in "${existing[@]}"; do
    name="$(basename "$file")"
    version="${name#${LABEL}-v}"
    version="${version%.apk}"
    if [[ "$version" =~ ^[0-9]+$ ]] && (( version > max_version )); then
      max_version="$version"
    fi
  done
  next_version=$((max_version + 1))
fi

DEST="$APK_DIR/${LABEL}-v${next_version}.apk"
cp "$SRC" "$DEST"
echo "$DEST"
